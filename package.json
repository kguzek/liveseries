{
  "name": "liveseries",
  "homepage": "https://liveseri.es/",
  "version": "5.0.0",
  "type": "module",
  "engines": {
    "node": "^24.14.0"
  },
  "author": "Konrad Guzek",
  "license": "AGPL-3.0-only",
  "description": "The LiveSeries web application.",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "payload": "PAYLOAD_CONFIG_PATH=src/payload.config.ts payload",
    "types:check": "tsc --noEmit",
    "types:generate": "next typegen && payload generate:types",
    "knip": "knip",
    "ci": "pnpm types:check && payload migrate && pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "@codaworks/react-glow": "^1.0.6",
    "@hookform/resolvers": "^4.1.3",
    "@payloadcms/db-postgres": "^3.85.1",
    "@payloadcms/email-nodemailer": "^3.85.1",
    "@payloadcms/next": "^3.85.1",
    "@payloadcms/richtext-lexical": "^3.85.1",
    "@payloadcms/storage-s3": "^3.85.1",
    "@radix-ui/react-alert-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@tanstack/react-query": "^5.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.39.4",
    "graphql": "^16.14.1",
    "html-to-text": "^9.0.5",
    "husky": "^9.1.7",
    "js-cookie": "^3.0.8",
    "lint-staged": "^16.4.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.7",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "next-turnstile": "^1.0.7",
    "nprogress": "^0.2.0",
    "payload": "^3.85.1",
    "prettier": "^3.9.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.78.0",
    "react-stacked-center-carousel": "^1.0.14",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tvmaze-wrapper-ts": "^2.1.2",
    "uuid": "^14.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@next/eslint-plugin-next": "^16.2.7",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/html-to-text": "^9.0.4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.19.20",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint-config-next": "^16.2.7",
    "knip": "^6.15.0",
    "postcss": "^8.5.15",
    "postcss-load-config": "^6.0.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.ts?(x)": "eslint"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "@tailwindcss/oxide",
      "esbuild",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "@swc/core",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.32.1",
  "volta": {
    "node": "24.14.0"
  }
}
